1:["$","div",null,{"className":"__variable_montserrat_18p2bc2","children":["$","$La",null,{"config":{"id":"cartagena-dubai","name":"Hotel Cartagena Dubai","shortName":"Cartagena Dubai","location":"Bocagrande · Cartagena de Indias","heroTitle":"Cartagena sube,","heroAccent":"el horizonte se abre.","heroDescription":"Tres noches frente al Caribe en una torre inspirada en el mundo árabe. Vuelos, traslados, todo incluido y tour a Playa Barú reunidos en un mismo plan.","storyEyebrow":"HOTEL CARTAGENA DUBAI · BOCAGRANDE","storyTitle":"Altura, mar y una Cartagena diferente.","story":"Cartagena Dubai se eleva en Bocagrande con una propuesta temática inspirada en la arquitectura árabe. Sus 30 pisos, las vistas hacia el mar y la ciudad, la piscina y los espacios en altura convierten el hotel en una experiencia visual desde que llegas.","storyNote":"El hotel cuenta con varias categorías y capacidades. Trvely trabaja con Estándar, Superior, Junior Suite y Master Suite, pero la categoría incluida será únicamente la que figure en la cotización final.","officialUrl":"https://www.cartagenadubai.com/","officialRoomsUrl":"https://www.cartagenadubai.com/habitaciones","hero":{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510491/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_002.jpg","alt":"Vista representativa del Hotel Cartagena Dubai en Bocagrande"},"featurePhoto":{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510497/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_012.jpg","alt":"Instalaciones del Hotel Cartagena Dubai con vista a la ciudad y al mar"},"highlights":[{"title":"30 pisos","detail":"Una torre vertical con ambientes y perspectivas diferentes de Cartagena."},{"title":"Vistas en altura","detail":"Terraza panorámica, mirador y puente de cristal según operación del hotel."},{"title":"Piscina","detail":"Zona para refrescarse y disfrutar el paisaje de Bocagrande."},{"title":"Ubicación","detail":"Frente al mar y a aproximadamente 15 minutos del aeropuerto, según el hotel."}],"rooms":[{"name":"Estándar","eyebrow":"BASE COMERCIAL TRVELY","description":"La categoría de entrada al hotel, con alternativas de vista a la ciudad y espacios funcionales.","details":["Vista ciudad","Wi-Fi","Aire acondicionado"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510498/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_013.jpg"},{"name":"Superior","eyebrow":"VISTA AL MAR","description":"Una alternativa para quienes quieren que el Caribe sea parte del descanso y del despertar.","details":["Vista al mar","Según ocupación","Sujeta a suplemento"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510500/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_016.jpg"},{"name":"Junior Suite","eyebrow":"MÁS AMPLITUD","description":"Una categoría superior con vista al mar y mayor capacidad, ideal para compartir la experiencia.","details":["Vista al mar","Capacidad por validar","Categoría superior"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510501/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_017.jpg"},{"name":"Master Suite","eyebrow":"PARA GRUPOS","description":"La opción más amplia del inventario comercial, pensada para grupos y sujeta a capacidad confirmada.","details":["Vista al mar","Hasta 6 según hotel","Sujeta a suplemento"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510505/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_022.jpg"}],"gallery":[{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510491/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_002.jpg","alt":"Vista exterior representativa del Hotel Cartagena Dubai."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510494/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_006.jpg","alt":"Arquitectura y ambientes del Hotel Cartagena Dubai."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510497/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_012.jpg","alt":"Espacios del hotel en el entorno de Bocagrande."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510498/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_013.jpg","alt":"Habitación representativa del inventario de Cartagena Dubai."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510500/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_016.jpg","alt":"Ambiente interior del hotel preparado para el descanso."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510501/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_017.jpg","alt":"Otra habitación representativa disponible en la propiedad."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510517/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_042.jpg","alt":"Piscina del hotel con vista al Caribe."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510527/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_058.jpg","alt":"Una perspectiva más de la experiencia Cartagena Dubai."}]}}]}]
