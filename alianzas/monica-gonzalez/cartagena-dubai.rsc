1:["$","div",null,{"className":"__variable_montserrat_18p2bc2","children":["$","$La",null,{"config":{"id":"cartagena-dubai","name":"Hotel Cartagena Dubai","shortName":"Cartagena Dubai","location":"Bocagrande · Cartagena de Indias","heroTitle":"Cartagena sube,","heroAccent":"el horizonte se abre.","heroDescription":"Tres noches frente al Caribe en una torre inspirada en el mundo árabe. Vuelos, traslados, todo incluido y tour a Playa Barú reunidos en un mismo plan.","storyEyebrow":"HOTEL CARTAGENA DUBAI · BOCAGRANDE","storyTitle":"Altura, mar y una Cartagena diferente.","story":"Cartagena Dubai se eleva en Bocagrande con una propuesta temática inspirada en la arquitectura árabe. Sus 30 pisos, las vistas hacia el mar y la ciudad, la piscina y los espacios en altura convierten el hotel en una experiencia visual desde que llegas.","storyNote":"El hotel cuenta con varias categorías y capacidades. Trvely trabaja con Estándar, Superior, Junior Suite y Master Suite, pero la categoría incluida será únicamente la que figure en la cotización final.","officialUrl":"https://www.cartagenadubai.com/","officialRoomsUrl":"https://www.cartagenadubai.com/habitaciones","hero":{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-2-2304w.jpg","alt":"Hotel Cartagena Dubai destacado en la línea costera de Bocagrande frente al Caribe"},"featurePhoto":{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-4-2304w.jpg","alt":"Piscina y fachada dorada del Hotel Cartagena Dubai vistas desde el aire"},"highlights":[{"title":"30 pisos","detail":"Una torre vertical con ambientes y perspectivas diferentes de Cartagena."},{"title":"Vistas en altura","detail":"Terraza panorámica, mirador y puente de cristal según operación del hotel."},{"title":"Piscina","detail":"Zona para refrescarse y disfrutar el paisaje de Bocagrande."},{"title":"Ubicación","detail":"Frente al mar y a aproximadamente 15 minutos del aeropuerto, según el hotel."}],"rooms":[{"name":"Estándar","eyebrow":"BASE COMERCIAL TRVELY","description":"La categoría de entrada al hotel, con alternativas de vista a la ciudad y espacios funcionales.","details":["Vista ciudad","Wi-Fi","Aire acondicionado"],"image":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-47-65661f51-2880w.jpg"},{"name":"Superior","eyebrow":"VISTA AL MAR","description":"Una alternativa para quienes quieren que el Caribe sea parte del descanso y del despertar.","details":["Vista al mar","Según ocupación","Sujeta a suplemento"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510498/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_013.jpg"},{"name":"Junior Suite","eyebrow":"MÁS AMPLITUD","description":"Una categoría superior con vista al mar y mayor capacidad, ideal para compartir la experiencia.","details":["Vista al mar","Capacidad por validar","Categoría superior"],"image":"https://res.cloudinary.com/trvely/image/upload/v1781510505/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_022.jpg"},{"name":"Master Suite","eyebrow":"PARA GRUPOS","description":"La opción más amplia del inventario comercial, pensada para grupos y sujeta a capacidad confirmada.","details":["Vista al mar","Hasta 6 según hotel","Sujeta a suplemento"],"image":"https://media.omnibees.com/Images/17253/RoomTypes/640x426/1085383.jpg/"}],"gallery":[{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-2-2304w.jpg","alt":"El hotel destaca en la línea costera de Bocagrande."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-36-2304w.jpg","alt":"Vista aérea nocturna del Hotel Cartagena Dubai en Bocagrande."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-4-2304w.jpg","alt":"Vista aérea de la piscina junto a la fachada dorada del hotel."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-52-2304w.jpg","alt":"Piscina iluminada del hotel con vista a la costa de Cartagena."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-16-2304w.jpg","alt":"Terraza en altura con panorámica nocturna de Cartagena."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-5-2304w.jpg","alt":"Lobby luminoso del Hotel Cartagena Dubai."},{"src":"https://irp.cdn-website.com/b8e59e8d/dms3rep/multi/opt/DUBAI-CARTAGENA-47-65661f51-2880w.jpg","alt":"Habitación luminosa con vista desde el Hotel Cartagena Dubai."},{"src":"https://res.cloudinary.com/trvely/image/upload/v1781510498/trvely/hoteles/cartagena/cartagena-dubai/imagenes/cartagena-dubai_013.jpg","alt":"Habitación representativa del Hotel Cartagena Dubai."}]},"branding":{"basePath":"/alianzas/monica-gonzalez/","homeAria":"Volver a los convenios empresariales de Trvely","lockup":"CONVENIOS EMPRESARIALES","label":"CONVENIO EMPRESARIAL","kicker":"CONVENIO EMPRESARIAL","switcherHeading":"CONVENIOS EMPRESARIALES · PRODUCTOS DISPONIBLES","program":"empresarial","packageLabel":"del convenio","whatsapp":"573013489910","greeting":"Hola, Mónica. Te escribo desde la página de convenios empresariales de Trvely.","contactName":"Mónica","contactLine":"Te atiende Mónica Lucía González Fonseca · +57 301 348 9910","requestTo":"a Mónica","requestPhrase":"Quiero solicitarte"}}]}]
